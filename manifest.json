{
  "manifest_version": 3,
  "name": "飞书文档转存",
  "version": "2.28.6",
  "description": "飞书文档转存：优先原生复制；禁止复制时高保真重建。零配置。",
  "permissions": [
    "storage",
    "downloads",
    "debugger"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "飞书文档转存",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.feishu.cn/*"
      ],
      "js": [
        "core/block-tree.js",
        "core/style-fidelity.js",
        "core/html-normalize.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}